  "authPlugins": ["mysql_native_password", "caching_sha2_password"],
  "tlsModes": ["verify_identity"],
  "profiles": [
    {
      "id": "M1",
      "features": [],
      "authPlugins": ["mysql_native_password", "caching_sha2_password"]
    },
    {
      "id": "M2",
      "features": [],
      "authPlugins": ["mysql_native_password", "caching_sha2_password"]
    },
    {
      "id": "M3",
      "features": [],
      "authPlugins": ["mysql_native_password", "caching_sha2_password"]
    },
    {
      "id": "M4",
      "features": ["sha256"],
      "authPlugins": ["caching_sha2_password"]
    }
  ]
}
