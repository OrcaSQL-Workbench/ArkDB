{
  "schemaVersion": 1,
  "driver": "mysql",
  "caseManifestFile": "device-acceptance-cases.json",
  "suiteId": "arkdb.mysql.device-acceptance",
  "serverFamilies": ["MySQL"],
  "features": [
    "multi-statements",
    "procedures",
    "text-parameters",
    "sha256",
    "compression",
    "local-infile",
    "failover",
    "worker",
    "session-observations",
    "routing"
