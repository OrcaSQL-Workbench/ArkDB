{
  "name": "arkdb-tooling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "restore": "node tools/run-ohpm.mjs install --all",
    "drivers": "node tools/plan-har-builds.mjs",
    "check": "npm run test:tools && node tools/check-package.mjs",
    "test:tools": "node --test --test-concurrency=1 tools/*.test.mjs",
    "build": "node tools/run-hvigor.mjs -- --mode module -p module=mysql@default -p product=default assembleHar --no-daemon",
    "build:release": "node tools/run-hvigor.mjs -- --mode module -p module=mysql@default -p product=default -p buildMode=release assembleHar --no-daemon",
    "test:arkts": "node tools/run-ohos-tests.mjs",
    "pack": "node tools/package-har.mjs",
    "test:consumer": "node tools/test-consumer.mjs",
    "example:prepare": "node tools/test-consumer.mjs --prepare",
    "example:build": "node tools/test-consumer.mjs --example",
    "verify:registry": "node tools/test-consumer.mjs --registry",
    "release:check": "node tools/check-release.mjs",
    "release:prepare": "node tools/prepare-har-release.mjs",
    "release:publish": "node tools/publish-har.mjs",
    "release:verify-download": "node tools/verify-download.mjs",
    "verify": "npm run check && npm run build && npm run test:arkts && npm run pack && npm run test:consumer && npm run release:check"
  },
  "devDependencies": {
    "json5": "2.2.3",
    "tar": "7.5.22"
  }
}
